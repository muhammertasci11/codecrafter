# Turso (libSQL) — Vercel deploy için ZORUNLU
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Gumroad — Ödeme için (Stripe yerine)
GUMROAD_TOKEN=your-gumroad-token
GUMROAD_PRODUCT_ID=your-product-permalink

# Local development (opsiyonel, Turso yoksa local SQLite kullanılır)
DB_PATH=data/codecrafter.db

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_AUTO_ADS=true
# Slot ID'lerini AdSense > Reklam > Reklam Birimleri sayfasindan olusturun:
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=xxxxxxxxx
# NEXT_PUBLIC_ADSENSE_INTERSTITIAL_SLOT=xxxxxxxxx
# NEXT_PUBLIC_ADSENSE_NATIVE_SLOT=xxxxxxxxx
