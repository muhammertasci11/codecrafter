{
  "appId": "com.codecrafter.app",
  "appName": "CodeCrafter",
  "webDir": "out",
  "server": {
    "url": "https://codicrafter.netlify.app",
    "cleartext": true,
    "allowNavigation": [
      "codicrafter.netlify.app",
      "*.netlify.app",
      "*.turso.io"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a1a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
